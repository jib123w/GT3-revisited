+	vbuffer = fbuffer = NULL;
+	const GLboolean reserved = sceGxmReserveVertexDefaultUniformBuffer(gxm_context, &vbuffer) >= 0 && vbuffer &&
+		sceGxmReserveFragmentDefaultUniformBuffer(gxm_context, &fbuffer) >= 0 && fbuffer;
+	if (reserved) {
+		sceGxmSetUniformDataF(vbuffer, clear_position, 0, 4, &clear_vertices->x);
