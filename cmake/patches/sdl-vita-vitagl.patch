 #ifdef SDL_VIDEO_VITA_PVR_OGL
     if (SDL_GetHintBoolean(SDL_HINT_VITA_PVR_OPENGL, false)) {
         device->GL_LoadLibrary = VITA_GL_LoadLibrary;
