+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#if defined(SDL_VIDEO_DRIVER_VITA) && defined(SDL_VIDEO_VITA_VITAGL)
+
+/* OpenGL ES through vitaGL, an OpenGL implementation on GXM. Unlike Piglet and PVR_PSP2 (OpenGL
+   ES 2.0) it has much of OpenGL ES 3.0: instanced draws, uniform blocks, vertex arrays. vitaGL
+   owns GXM and the display, so SDL's vitagxm renderer must not be created beside it.
+
+   Hints (read once, when the first context is created):
+     SDL_VITA_VGL_RAM_THRESHOLD  bytes of main memory vitaGL leaves for everyone else (8 MB)
+     SDL_VITA_VGL_MSAA           0, 2 or 4: the display's multisampling (0) */
+
+#include <vitaGL.h>
+
+#include "SDL_vitavideo.h"
+
+static bool vitagl_ready = false;
+static int vitagl_swap_interval = 1;
+
+bool VITA_VGL_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    return true; // linked in
+}
+
+SDL_FunctionPointer VITA_VGL_GetProcAddress(SDL_VideoDevice *_this, const char *proc)
+{
+    return (SDL_FunctionPointer)vglGetProcAddress(proc);
+}
+
+void VITA_VGL_UnloadLibrary(SDL_VideoDevice *_this)
+{
+}
+
+SDL_GLContext VITA_VGL_CreateContext(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *wdata = window->internal;
+
+    if (!vitagl_ready) {
+        const char *threshold_hint = SDL_GetHint("SDL_VITA_VGL_RAM_THRESHOLD");
+        const char *msaa_hint = SDL_GetHint("SDL_VITA_VGL_MSAA");
+        const int threshold = threshold_hint ? SDL_atoi(threshold_hint) : 8 * 1024 * 1024;
+        const int samples = msaa_hint ? SDL_atoi(msaa_hint) : 0;
+        const SceGxmMultisampleMode msaa = samples >= 4 ? SCE_GXM_MULTISAMPLE_4X
+                                         : samples >= 2 ? SCE_GXM_MULTISAMPLE_2X
+                                                        : SCE_GXM_MULTISAMPLE_NONE;
+        // No legacy (glBegin/glEnd) pool: OpenGL ES has no immediate mode. The return value is
+        // not success: GL_TRUE says the size was lowered to the display's largest, and an init
+        // at 960x544 that worked returns GL_FALSE. vitaGL has no failure return.
+        (void)vglInitExtended(0, 960, 544, threshold, msaa);
+        vglWaitVblankStart(vitagl_swap_interval != 0 ? GL_TRUE : GL_FALSE);
+        vitagl_ready = true;
+    }
+
+    wdata->uses_gles = true;
+    window->flags |= SDL_WINDOW_FULLSCREEN;
+
+    // vitaGL has a single context; any non-NULL handle stands for it.
+    return (SDL_GLContext)window;
+}
+
+bool VITA_VGL_MakeCurrent(SDL_VideoDevice *_this, SDL_Window *window, SDL_GLContext context)
+{
+    return true;
+}
+
+bool VITA_VGL_SetSwapInterval(SDL_VideoDevice *_this, int interval)
+{
+    vitagl_swap_interval = interval;
+    if (vitagl_ready) {
+        vglWaitVblankStart(interval != 0 ? GL_TRUE : GL_FALSE);
+    }
+    return true;
+}
+
+bool VITA_VGL_GetSwapInterval(SDL_VideoDevice *_this, int *interval)
+{
+    *interval = vitagl_swap_interval;
+    return true;
+}
+
+bool VITA_VGL_SwapWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_VideoData *videodata = _this->internal;
+    // An open IME dialog draws itself over the frame being presented.
+    vglSwapBuffers(videodata->ime_active ? GL_TRUE : GL_FALSE);
+    return true;
+}
+
+bool VITA_VGL_DestroyContext(SDL_VideoDevice *_this, SDL_GLContext context)
+{
+    return true; // vitaGL lives as long as the process
+}
+
+#endif // SDL_VIDEO_DRIVER_VITA && SDL_VIDEO_VITA_VITAGL
